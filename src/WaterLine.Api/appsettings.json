      "PercentualEntradaBloqueada": 70,
      "PercentualSedimentoMinimo": 30,
      "PercentualTuboEntupido": 60,
      "HorasAguaParadaTubo": 24,
      "VelocidadeSubidaCmPorMinuto": 5,
      "PercentualNivelCritico": 85
